{
  "name": "sistema-de-ventas",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema POS para loncherías (monorepo: frontend React + backend Express + SQLite)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,yellow \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:studio": "npm run db:studio -w backend",
    "db:backup": "npm run db:backup -w backend",
    "db:restore": "npm run db:restore -w backend",
    "test:backend": "npm run test -w backend",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:playwright": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "concurrently": "^9.1.2",
    "deepmerge-ts": "^8.0.2",
    "ip-address": "^10.7.4",
    "nanoid": "^3.3.20",
    "qs": "^6.16.0",
    "source-map-js": "^1.2.2"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "deepmerge-ts": "^8.0.2",
    "ip-address": "^10.7.4",
    "nanoid": "^3.3.20",
    "qs": "^6.16.0",
    "source-map-js": "^1.2.2"
  }
}
