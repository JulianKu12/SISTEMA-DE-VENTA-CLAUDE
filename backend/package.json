{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST del sistema POS para loncherías (Express + Prisma + SQLite)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:pruebas": "node prisma/seed-pruebas.js",
    "db:studio": "prisma studio",
    "db:backup": "node scripts/backup-db.js",
    "db:restore": "node scripts/restore-db.js",
    "test": "node scripts/run-backend-tests.js",
    "db:push:e2e": "prisma db push --schema prisma/schema.prisma --skip-generate",
    "test:e2e:seed": "node scripts/seed-e2e.js"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "prisma": "^6.12.0"
  }
}
