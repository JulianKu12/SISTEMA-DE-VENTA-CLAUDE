# Copia este archivo a `.env` y completa los valores. NUNCA subas `.env` reales
# (ya está cubierto por .gitignore).

# Base de datos SQLite local (archivo .db dentro del backend).
DATABASE_URL="file:./dev.db"

# OBLIGATORIO: secreto JWT para firmar las sesiones. El servidor NO arranca sin
# él (no hay valor por defecto). Genera uno aleatorio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-valor-por-un-secreto-aleatorio

# Opcional: límites de peticiones por IP (rate limiting).
# Máximo de intentos de login FALLIDOS por IP cada 15 minutos.
RATE_LIMIT_LOGIN_MAX=5
# Máximo de peticiones por IP por minuto al resto de la API (anti-abuso).
RATE_LIMIT_GENERAL_MAX=100

# Opcional: orígenes permitidos para CORS (separados por comas). Por defecto
# solo el frontend de desarrollo. En cada instalación pon la URL real del
# frontend (ej. la IP/puerto de la tablet: http://192.168.1.50:5173).
# CORS_ORIGIN=http://localhost:5173
# CORS_ORIGIN=http://192.168.1.50:5173,http://localhost:5173

# Opcional: puerto del servidor (por defecto 3001).
# PORT=3001