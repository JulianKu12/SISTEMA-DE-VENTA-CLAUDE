# Copia este archivo a `.env` y completa los valores. NUNCA subas `.env` reales
# (ya está cubierto por .gitignore).

# Base de datos SQLite local (archivo .db dentro del backend).
DATABASE_URL="file:./dev.db"

# OBLIGATORIO: secreto JWT para firmar las sesiones. El servidor NO arranca sin
# él (no hay valor por defecto). Genera uno aleatorio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-valor-por-un-secreto-aleatorio

# Opcional: límites de peticiones por IP (rate limiting). En producción
# RATE_LIMIT_LOGIN_MAX tiene máximo 20 y RATE_LIMIT_GENERAL_MAX máximo 1000.
# Máximo de intentos de login FALLIDOS por IP cada 15 minutos.
RATE_LIMIT_LOGIN_MAX=5
# Máximo de peticiones por IP por minuto al resto de la API (anti-abuso).
RATE_LIMIT_GENERAL_MAX=100

# Opcional: crear el Usuario Administrador inicial sin interacción con
# `npm run db:seed`. Solo se usa si AMBAS variables están seteadas; si no,
# el seed las pide por consola (modo interactivo, por defecto). NO pongas
# aquí una credencial real, rellénalas solo al momento de ejecutar.
# ADMIN_USUARIO=
# ADMIN_CONTRASEÑA=

# Orígenes permitidos para CORS, separados por comas. En producción es
# obligatorio declarar el origen exacto del frontend. No se permite "*".
# En desarrollo, si no se especifica, solo se permite localhost:5173.
# CORS_ORIGIN=http://localhost:5173
# CORS_ORIGIN=http://192.168.1.50:5173,http://localhost:5173
# CORS_ORIGIN=https://pos.ejemplo.com

# Si estás detrás de un proxy / ingress, define el valor de confianza para X-Forwarded-For.
# 1 = confía en un salto, false = no confiar en proxies, "loopback" = solo loopback.
# TRUST_PROXY=1

# Opcional: puerto del servidor (por defecto 3001).
# PORT=3001

# Respaldos SQLite automáticos al arrancar y cada 24 horas.
# Las copias se verifican y se guardan en backend/backups por defecto.
# No se borran automáticamente; protege esta carpeta y copia respaldos fuera
# del equipo periódicamente.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_DIR=backups

# Antes de iniciar en producción:
# - define NODE_ENV=production
# - reemplaza JWT_SECRET por un secreto aleatorio de al menos 32 caracteres
# - define DATABASE_URL con un archivo SQLite persistente que no sea dev.db/test.db
# - declara CORS_ORIGIN con el origen del frontend (sin rutas, query ni *)